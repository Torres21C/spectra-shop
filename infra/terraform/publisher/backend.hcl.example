# Copie a backend.hcl (ignorado por Git) y complete con las salidas de infra/terraform/bootstrap.
# La clave (key) es distinta de la de environments/lab: cada raíz tiene su propio state.
bucket       = "<state-bucket-de-bootstrap>"
key          = "spectra-shop/publisher/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "<arn-de-la-clave-kms-del-state>"
use_lockfile = true
