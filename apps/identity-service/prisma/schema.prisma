generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/identity-client"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(20)
  name  String @db.VarChar(80)
  users User[]

  @@map("roles")
}

model User {
  id                       String        @id @default(uuid()) @db.Uuid
  roleId                   String        @map("role_id") @db.Uuid
  fullName                 String        @map("full_name") @db.VarChar(80)
  emailNormalized          String        @unique @map("email_normalized") @db.VarChar(254)
  passwordHash             String        @map("password_hash") @db.VarChar(255)
  isActive                 Boolean       @default(true) @map("is_active")
  failedLoginCount         Int           @default(0) @map("failed_login_count")
  failedLoginWindowStarted DateTime?     @map("failed_login_window_started") @db.Timestamptz(3)
  lockedUntil              DateTime?     @map("locked_until") @db.Timestamptz(3)
  lastLoginAt              DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  role                     Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions                 AuthSession[]

  @@index([lockedUntil])
  @@map("users")
}

model AuthSession {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivityAt    DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?        @map("revoke_reason") @db.VarChar(40)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id           String       @id @default(uuid()) @db.Uuid
  sessionId    String       @map("session_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash") @db.Char(64)
  familyId     String       @map("family_id") @db.Uuid
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?    @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  replacedById String?      @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  session      AuthSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshRotation")

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(50)
  result      String    @db.VarChar(20)
  actorId     String?   @map("actor_id") @db.Uuid
  requestId   String?   @map("request_id") @db.Uuid
  metadata    Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}
