generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(64)
  name      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  products  Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id               String                 @id @default(uuid()) @db.Uuid
  categoryId       String                 @map("category_id") @db.Uuid
  sku              String                 @unique @db.VarChar(64)
  name             String                 @db.VarChar(150)
  description      String                 @db.VarChar(2000)
  searchText       String                 @map("search_text") @db.VarChar(2200)
  price            Decimal                @db.Decimal(10, 2)
  stock            Int
  imageKey         String                 @map("image_key") @db.VarChar(64)
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reservationLines StockReservationLine[]

  @@index([categoryId])
  @@index([isActive, name])
  @@index([searchText])
  @@map("products")
}

/// DT-08 (M06.0): FULFILLED = Commerce reconoció la reserva con su pedido (reconocimiento técnico,
/// no entrega física); RESTOCKED = reposición por cancelación (M06). Estados internos de Catalog.
enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  FULFILLED
  RESTOCKED
}

/// Reserva de inventario solicitada por Commerce (saga M04). El stock se descuenta al reservar.
model StockReservation {
  id            String                 @id @db.Uuid
  caller        String                 @db.VarChar(32)
  status        ReservationStatus
  requestHash   String?                @map("request_hash") @db.Char(64)
  expiresAt     DateTime               @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt   DateTime?              @map("confirmed_at") @db.Timestamptz(3)
  releasedAt    DateTime?              @map("released_at") @db.Timestamptz(3)
  releaseReason String?                @map("release_reason") @db.VarChar(32)
  /// DT-08: pedido de Commerce vinculado de forma única al reconocer la entrega.
  orderId       String?                @unique @map("order_id") @db.Uuid
  fulfilledAt   DateTime?              @map("fulfilled_at") @db.Timestamptz(3)
  restockedAt   DateTime?              @map("restocked_at") @db.Timestamptz(3)
  lines         StockReservationLine[]

  @@index([status, expiresAt])
  @@index([status, confirmedAt])
  @@map("stock_reservations")
}

model StockReservationLine {
  reservationId String           @map("reservation_id") @db.Uuid
  productId     String           @map("product_id") @db.Uuid
  quantity      Int
  unitPrice     Decimal          @map("unit_price") @db.Decimal(10, 2)
  productName   String           @map("product_name") @db.VarChar(150)
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([reservationId, productId])
  @@index([productId])
  @@map("stock_reservation_lines")
}

/// M06/M07 mínimo: outbox transaccional de Catalog. El evento se escribe en la misma transacción que
/// el cambio administrativo y un relay lo entrega de forma idempotente a audit-service.
model OutboxEvent {
  id           String    @id @default(uuid()) @db.Uuid
  eventType    String    @map("event_type") @db.VarChar(50)
  result       String    @db.VarChar(20)
  actorId      String?   @map("actor_id") @db.Uuid
  actorRole    String?   @map("actor_role") @db.VarChar(20)
  resourceType String    @map("resource_type") @db.VarChar(40)
  resourceId   String?   @map("resource_id") @db.Uuid
  sourceIp     String?   @map("source_ip") @db.VarChar(64)
  requestId    String?   @map("request_id") @db.Uuid
  metadata     Json
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}
