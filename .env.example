# Administrador del clúster PostgreSQL. DT-09: solo lo usan el contenedor postgres y los jobs de
# aprovisionamiento (postgres-provision/postgres-finalize); ningún servicio se conecta con él.
POSTGRES_DB=spectra_shop
POSTGRES_USER=spectra_app
POSTGRES_PASSWORD=replace-with-a-local-random-value

# DT-09: un rol de migración y otro de ejecución por servicio, cada uno con su contraseña.
# Use valores hexadecimales distintos de 32 a 128 caracteres (p. ej. `openssl rand -hex 32`).
SPECTRA_IDENTITY_MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32
SPECTRA_IDENTITY_APP_PASSWORD=replace-with-openssl-rand-hex-32
SPECTRA_CATALOG_MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32
SPECTRA_CATALOG_APP_PASSWORD=replace-with-openssl-rand-hex-32
SPECTRA_COMMERCE_MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32
SPECTRA_COMMERCE_APP_PASSWORD=replace-with-openssl-rand-hex-32

# Genere estos valores fuera del repositorio. SPECTRA_INTERNAL_TOKENS admite
# el token actual y, durante una rotación, el anterior separados por coma.
SPECTRA_KEYS_DIR=/absolute/path/outside/repository/spectra-dev-keys
SPECTRA_INTERNAL_TOKEN=replace-with-a-random-32-character-or-longer-value
SPECTRA_INTERNAL_TOKENS=replace-with-current-token
# Alcance de inventario M04 (solo Commerce → Catalog). Debe ser distinto del token compartido.
CATALOG_INVENTORY_TOKEN=replace-with-a-different-random-32-character-or-longer-value
CATALOG_INVENTORY_TOKENS=replace-with-current-inventory-token
IDENTITY_ALLOW_EPHEMERAL_KEYS=false
COOKIE_SECURE=false
# M04.1 (opcionales): recuperación de sagas de checkout. Valores por defecto entre paréntesis.
# CHECKOUT_RECOVERY_BACKOFF_BASE_MS=15000
# CHECKOUT_RECOVERY_BACKOFF_MAX_MS=900000
# CHECKOUT_STUCK_AGE_MS=300000
# CHECKOUT_STUCK_ATTEMPTS=5
# DT-08 (opcionales): reconocimiento de entrega de reservas. Valores por defecto entre paréntesis.
# FULFILLMENT_RECOVERY_INTERVAL_MS=15000
# FULFILLMENT_RETRY_BASE_MS=15000
# FULFILLMENT_RETRY_MAX_MS=900000
# FULFILLMENT_STUCK_ATTEMPTS=5
# FULFILLMENT_STUCK_AGE_MS=300000
# RESERVATION_UNFULFILLED_AGE_SECONDS=300
# RESERVATION_DELIVERY_MONITOR_INTERVAL_MS=60000
