POSTGRES_DB=spectra_shop
POSTGRES_USER=spectra_app
POSTGRES_PASSWORD=replace-with-a-local-random-value

# M02 local usa una clave ES256 efímera en memoria. Para una clave persistente,
# defina IDENTITY_PRIVATE_KEY_PATH e IDENTITY_PUBLIC_KEY_PATH fuera del repositorio.
IDENTITY_ALLOW_EPHEMERAL_KEYS=true
COOKIE_SECURE=false
