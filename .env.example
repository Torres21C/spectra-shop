POSTGRES_DB=spectra_shop
POSTGRES_USER=spectra_app
POSTGRES_PASSWORD=replace-with-a-local-random-value

# Genere estos valores fuera del repositorio. SPECTRA_INTERNAL_TOKENS admite
# el token actual y, durante una rotación, el anterior separados por coma.
SPECTRA_KEYS_DIR=/absolute/path/outside/repository/spectra-dev-keys
SPECTRA_INTERNAL_TOKEN=replace-with-a-random-32-character-or-longer-value
SPECTRA_INTERNAL_TOKENS=replace-with-current-token
# Alcance de inventario M04 (solo Commerce → Catalog). Debe ser distinto del token compartido.
CATALOG_INVENTORY_TOKEN=replace-with-a-different-random-32-character-or-longer-value
CATALOG_INVENTORY_TOKENS=replace-with-current-inventory-token
IDENTITY_ALLOW_EPHEMERAL_KEYS=false
COOKIE_SECURE=false
